# ─── Copy to .env and fill in. .env is gitignored and must never be committed. ───

# Google AI Studio key (https://aistudio.google.com/apikey).
# Used for the TrueForge agent model, and later for STT/TTS.
GEMINI_API_KEY=

# Model the SunoAI agent runs on.
GEMINI_MODEL_ID=gemini-3-flash-preview

# Backup models, comma-separated, registered alongside the primary so switching
# is a one-line edit to GEMINI_MODEL_ID rather than a re-bootstrap.
# You need more than one: the free tier allows 20 requests per day PER MODEL,
# and one agent turn spends three to five. See README.
GEMINI_FALLBACK_MODEL_IDS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.1-flash-lite

# Where the TrueForge harness listens. Also where the voice client and UI connect.
TRUEFORGE_PORT=8790
TRUEFORGE_BASE_URL=http://localhost:8790

# Where the Playwright browser-control MCP server listens (HTTP transport).
# TrueForge only speaks to remote MCP servers over HTTP, so this runs as its own process.
BROWSER_MCP_PORT=8931
BROWSER_MCP_URL=http://localhost:8931/mcp

# On-disk Chrome profile, so the LinkedIn login survives between runs.
# Defaults to ./.browser-profile (gitignored).
BROWSER_PROFILE_DIR=

# Which site the flow runs against: naukri or linkedin.
TARGET_SITE=naukri

# Naukri search keyword. Fixed so a demo lands on the same search every time.
NAUKRI_QUERY=analytics
