# ─── Copy to .env and fill in. .env is gitignored and must never be committed. ───

# Google AI Studio key (https://aistudio.google.com/apikey).
# Used for the TrueForge agent model, and later for STT/TTS.
GEMINI_API_KEY=

# Model the SunoAI agent runs on.
GEMINI_MODEL_ID=gemini-3-flash-preview

# Backup model, registered alongside the primary so a demo can switch by
# editing GEMINI_MODEL_ID rather than re-bootstrapping. gemini-3-flash-preview
# intermittently returns 503 "experiencing high demand"; see README.
GEMINI_FALLBACK_MODEL_ID=gemini-3.6-flash

# Where the TrueForge harness listens. Also where the voice client and UI connect.
TRUEFORGE_PORT=8790
TRUEFORGE_BASE_URL=http://localhost:8790

# Where the Playwright browser-control MCP server listens (HTTP transport).
# TrueForge only speaks to remote MCP servers over HTTP, so this runs as its own process.
BROWSER_MCP_PORT=8931
BROWSER_MCP_URL=http://localhost:8931/mcp

# On-disk Chrome profile, so the LinkedIn login survives between runs.
# Defaults to ./.browser-profile (gitignored).
BROWSER_PROFILE_DIR=
